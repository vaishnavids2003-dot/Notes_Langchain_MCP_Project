# Normalize line endings: LF in the repo, each OS's native endings on checkout.
* text=auto

# Shell scripts must stay LF even on Windows or `bash` fails with "\r: command not found".
*.sh text eol=lf

# Never touch binaries.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.db binary
*.sqlite binary
